          "datasource": "Prometheus",
          "expr": "(sum(rate(api_requests_total{http_status=~\"4..|5..\"}[5m])) or vector(0)) / (sum(rate(api_requests_total[5m])) or vector(1)) * 100",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
